# Shared Secret für die Apple-Shortcuts-Schnittstelle (POST /api/ingest).
# Erzeugen mit: openssl rand -hex 32
INGEST_TOKEN=

# Ablageort der JSON-Datenbank. Lokal optional, im Container auf /data gesetzt.
# DATA_DIR=./data

# Startwerte, sofern noch keine Einstellungen gespeichert sind.
# START_WEIGHT_KG=113
# TARGET_WATTS_PER_KG=3.3

# Nur nötig, wenn das Dashboard hinter einem Reverse Proxy läuft,
# z. B. https://dashboard.fritz.box
# ALLOWED_ORIGINS=
